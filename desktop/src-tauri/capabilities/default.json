{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window: core window access plus permission to execute exactly the bundled Python sidecar, and nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/hermes-legal-sidecar",
          "sidecar": true,
          "args": ["serve", { "validator": "--port" }, { "validator": "\\d+" }]
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/hermes-legal-sidecar",
          "sidecar": true,
          "args": ["serve", { "validator": "--port" }, { "validator": "\\d+" }]
        }
      ]
    }
  ]
}
